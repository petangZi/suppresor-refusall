# Gate runtime secrets. Never commit the filled file.
SUPPRESOR_GATE_SECRET=change-me
# Inline PEM; "\n" escapes are converted to newlines. Omit to fall back to files.
SUPPRESOR_TOKEN_KEY_PEM=
SUPPRESOR_TOKEN_PUBLIC_PEM=
SUPPRESOR_LICENSE_PUBLIC_PEM=
# Optional tuning
SUPPRESOR_GATE_PORT=8787
SUPPRESOR_GATE_TTL=1800
SUPPRESOR_FREE_LIMIT=15
SUPPRESOR_GATE_IP_RATE=60
SUPPRESOR_GATE_NOPERSIST=1
