rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // CORE ZERO-TRUST SECURITY FUNCTIONS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && (request.auth.token.role == 'ADMIN' || request.auth.token.role == 'SUPER_ADMIN' || request.auth.token.role == 'OWNER')) ||
        ('email' in request.auth.token && request.auth.token.email != null &&
          request.auth.token.email.lower() == 'aketayaza@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isOwner == true)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'email' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email.lower() == 'aketayaza@gmail.com')
      );
    }

    // DENY ALL BY DEFAULT
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // USERS COLLECTION: users/{uid}
    // =========================================================================
    match /users/{uid} {
      // Owner or admin can read; the license client only reads its own ledger.
      allow read: if isOwner(uid) || isAdmin();

      // Two accepted shapes: the app profile (role/status) and the license
      // ledger (deviceId/keyRef/uses). Anything else is rejected.
      allow create: if (isOwner(uid)
                        && (
                          (request.resource.data.keys().hasOnly(['deviceId', 'keyRef', 'uses', 'lastUseAt'])
                           && request.resource.data.deviceId is string
                           && request.resource.data.uses is int
                           && request.resource.data.uses == 0)
                          ||
                          ((('email' in request.resource.data
                             && request.resource.data.email.lower() == 'aketayaza@gmail.com')
                            && request.resource.data.role == 'ADMIN')
                           || (request.resource.data.role == 'USER'
                               && request.resource.data.status == 'UNVERIFIED'
                               && (!('permissions' in request.resource.data) || request.resource.data.permissions.size() == 0)
                               && !('activeKeyId' in request.resource.data)))
                        ))
                     || isAdmin();

      // Ledger updates may only touch uses/lastUseAt/keyRef and never lower the
      // counter; profile updates keep the original privileged-field guard.
      allow update: if (isOwner(uid) && (
                          ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses', 'lastUseAt', 'keyRef'])
                            && (!('uses' in request.resource.data.diff(resource.data).affectedKeys())
                                || !('uses' in resource.data)
                                || request.resource.data.uses >= resource.data.uses))
                           || (('email' in resource.data
                                && resource.data.email.lower() == 'aketayaza@gmail.com')
                               || !request.resource.data.diff(resource.data).affectedKeys()
                                   .hasAny(['role', 'permissions', 'status', 'isAdmin', 'activeKeyId', 'email'])))
                        ))
                     || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    // SUPPORT SUBMISSIONS: supportSubmissions/{submissionId}
    // =========================================================================
    match /supportSubmissions/{submissionId} {
      // Users can only read their own submissions; Admins can read all
      allow read: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isAdmin();

      // Users can create a submission, but must set status to PENDING, match auth.uid, and not set admin fields
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'PENDING'
                    && request.resource.data.amount >= 1000
                    && !request.resource.data.keys().hasAny(['reviewedAt', 'reviewedBy', 'assignedKey', 'rejectionReason']);

      // Submissions cannot be updated or approved by regular users; ONLY by Admin
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // ACCESS KEYS: accessKeys/{keyId} (P0 Zero-Trust Hardening)
    // - Requires authentication for single get
    // - Listing / enumeration strictly forbidden
    // - Client-side create, update, delete strictly forbidden (Server/Bridge only)
    // =========================================================================
    match /accessKeys/{keyId} {
      // Exact-document read only. The key id is the credential; list/query and
      // every write stay closed, so this does not reopen enumeration.
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // =========================================================================
    // ACCESS KEYS PRIVATE: accessKeysPrivate/{keyId} (P0 Isolation)
    // - Contains key, keyHash, supporterEmail, supporterId
    // - NEVER readable or writable by any client (rules allow read, write: if false)
    // =========================================================================
    match /accessKeysPrivate/{keyId} {
      allow read, write: if false;
    }

    // =========================================================================
    // POLLS & VOTES
    // =========================================================================
    match /polls/{pollId} {
      // Public can read polls
      allow read: if true;

      // Only admin can create or delete polls
      allow create, delete: if isAdmin();

      // Updates: Admin can edit anything.
      // Authenticated users can only update options/totalVotes/votedUserIds when casting a vote
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['options', 'totalVotes', 'votedUserIds']) &&
        !resource.data.votedUserIds.hasAny([request.auth.uid]) &&
        request.resource.data.votedUserIds.hasAll(resource.data.votedUserIds) &&
        request.resource.data.votedUserIds.hasAny([request.auth.uid])
      );
    }

    match /votes/{voteId} {
      // Users can read their own vote or Admin can read all
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      // User can cast their vote matching their auth.uid
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // BETA RELEASES: betaReleases/{releaseId}
    // =========================================================================
    match /betaReleases/{releaseId} {
      // Public can view release roadmap and changelog
      allow read: if true;

      // STRICTLY Admin only can publish, update or delete releases
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // NOTIFICATIONS: notifications/{notificationId}
    // =========================================================================
    match /notifications/{notificationId} {
      // Users can only read notifications intended for them; Admins can read all
      allow read: if (isAuthenticated() && resource.data.recipientUid == request.auth.uid) || isAdmin();

      // Users can create notifications for themselves, or Admin can send
      allow create: if (isAuthenticated() && request.resource.data.recipientUid == request.auth.uid) || isAdmin();

      // Users can only update the 'read' flag on their own notifications
      allow update: if (isAuthenticated() && resource.data.recipientUid == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
                    || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    // AUDIT LOGS: auditLogs/{logId}
    // =========================================================================
    match /auditLogs/{logId} {
      // Sensitive audit logs can ONLY be read by Admin
      allow read: if isAdmin();

      // System events can be appended, never modified or deleted
      allow create: if true;
      allow update, delete: if false;
    }

    // =========================================================================
    // SYSTEM LOGS (INPUT/OUTPUT & EXECUTIONS): systemLogs/{logId}
    // =========================================================================
    match /systemLogs/{logId} {
      // System I/O logs can ONLY be read by Admin
      allow read: if isAdmin();

      // System events can be appended, never modified or deleted
      allow create: if true;
      allow update, delete: if false;
    }

    // =========================================================================
    // SITE SETTINGS: siteSettings/{settingId}
    // =========================================================================
    match /siteSettings/{settingId} {
      // Everyone can read public site settings
      allow read: if true;

      // STRICTLY ADMIN ONLY for modifying global settings
      allow write: if isAdmin();
    }

    // =========================================================================
    // PROMPTS VAULT: prompts/{promptId}
    // =========================================================================
    match /prompts/{promptId} {
      // Prompts vault shared catalog
      allow read, create, update, delete: if true;
    }
  }
}
