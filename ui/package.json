{
  "name": "suppresor-ui",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.tsx",
    "start": "bun run src/index.tsx",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.tsx --target bun --outdir dist --minify",
    "postinstall": "node scripts/ensure-babel-solid.mjs"
  },
  "dependencies": {
    "@opentui/core": "^0.7.0",
    "@opentui/solid": "^0.7.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-typescript": "^8.0.7",
    "@types/bun": "^1.4.4",
    "babel-preset-solid": "1.9.12",
    "typescript": "^7.0.2"
  }
}
