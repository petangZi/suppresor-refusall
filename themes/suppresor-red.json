{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Suppresor Refusall Red",
  "id": "suppresor-red",
  "light": {
    "palette": {
      "neutral": "#1c0505",
      "ink": "#6b1a1a",
      "primary": "#cc0000",
      "accent": "#e63946",
      "success": "#a4161a",
      "warning": "#ba181b",
      "error": "#d00000",
      "info": "#e5383b",
      "interactive": "#cc0000",
      "diffAdd": "#4d7a3c",
      "diffDelete": "#d00000"
    },
    "overrides": {
      "text-weak": "#a35555",
      "syntax-comment": "#9c5c5c",
      "syntax-keyword": "#cc0000",
      "syntax-string": "#a4161a",
      "syntax-primitive": "#ba181b",
      "syntax-variable": "#660708",
      "syntax-property": "#cc0000",
      "syntax-type": "#bc4749",
      "syntax-constant": "#d00000",
      "syntax-operator": "#ba181b",
      "syntax-punctuation": "#6b1a1a",
      "syntax-object": "#660708",
      "markdown-heading": "#cc0000",
      "markdown-text": "#6b1a1a",
      "markdown-link": "#9d0208",
      "markdown-link-text": "#a4161a",
      "markdown-code": "#6a040f",
      "markdown-block-quote": "#a35555",
      "markdown-emph": "#9d0208",
      "markdown-strong": "#6a040f",
      "markdown-horizontal-rule": "#c9a3a3",
      "markdown-list-item": "#9d0208",
      "markdown-list-enumeration": "#ba181b",
      "markdown-image": "#9d0208",
      "markdown-image-text": "#a4161a",
      "markdown-code-block": "#6b1a1a"
    },
    "v2Overrides": {
      "v2-text-text-base": "#6b1a1a",
      "v2-text-text-muted": "#a35555",
      "v2-text-text-faint": "#c9a3a3",
      "v2-background-bg-accent": "var(--v2-red-600)",
      "v2-text-text-accent": "var(--v2-red-600)",
      "v2-text-text-accent-hover": "var(--v2-red-700)",
      "v2-icon-icon-accent": "var(--v2-red-600)",
      "v2-icon-icon-accent-hover": "var(--v2-red-700)",
      "v2-border-border-focus": "var(--v2-red-500)"
    }
  },
  "dark": {
    "palette": {
      "neutral": "#0d0000",
      "ink": "#ffd9d9",
      "primary": "#ff1a1a",
      "accent": "#e60000",
      "success": "#ff6b6b",
      "warning": "#ff4444",
      "error": "#ff0000",
      "info": "#ff7777",
      "interactive": "#ff1a1a",
      "diffAdd": "#6bff8a",
      "diffDelete": "#ff4444"
    },
    "overrides": {
      "text-weak": "#8a4b4b",
      "syntax-comment": "#7a3d3d",
      "syntax-keyword": "#ff4444",
      "syntax-string": "#ff8a8a",
      "syntax-primitive": "#ff5555",
      "syntax-variable": "#ffd9d9",
      "syntax-property": "#ff7777",
      "syntax-type": "#ff6666",
      "syntax-constant": "#ff3333",
      "syntax-operator": "#ff8888",
      "syntax-punctuation": "#ffd9d9",
      "syntax-object": "#ff9a9a",
      "markdown-heading": "#ff1a1a",
      "markdown-text": "#ffd9d9",
      "markdown-link": "#ff4444",
      "markdown-link-text": "#ff7777",
      "markdown-code": "#ff8a8a",
      "markdown-block-quote": "#a35555",
      "markdown-emph": "#ff7777",
      "markdown-strong": "#ff3333",
      "markdown-horizontal-rule": "#5c1a1a",
      "markdown-list-item": "#ff4444",
      "markdown-list-enumeration": "#ff7777",
      "markdown-image": "#ff4444",
      "markdown-image-text": "#ff7777",
      "markdown-code-block": "#ffd9d9"
    },
    "v2Overrides": {
      "v2-text-text-base": "#ffd9d9",
      "v2-text-text-muted": "#a35555",
      "v2-text-text-faint": "#7a3d3d",
      "v2-background-bg-accent": "#8a0000",
      "v2-text-text-accent": "#ff4444",
      "v2-text-text-accent-hover": "#ff6666",
      "v2-icon-icon-accent": "#ff4444",
      "v2-icon-icon-accent-hover": "#ff6666",
      "v2-border-border-focus": "#ff1a1a"
    }
  }
}